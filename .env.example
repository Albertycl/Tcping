# Copy to .env. docker-compose.standalone.yml needs only MYSQL_APP_PASSWORD and FRONTEND_PORT.
# MYSQL_HOST, MYSQL_DATABASE and MYSQL_USER are used only by docker-compose.yml (existing MariaDB container).
MYSQL_HOST=netdiag-mariadb-1
MYSQL_DATABASE=tcping
MYSQL_USER=tcping
MYSQL_APP_PASSWORD=change-me
FRONTEND_PORT=5435
